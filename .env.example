# Configure these variables in the hosting service (the app does not load .env automatically).
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DB_PATH=/app/data/agenda.sqlite
PUBLIC_ORIGIN=https://agenda.example.com
# Set a random private code; required only to create the first personal account online.
SETUP_TOKEN=replace-with-a-long-random-code
